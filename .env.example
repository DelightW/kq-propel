# KQ-Propel environment configuration
# Copy this file to .env and fill in the values you have.
# Every variable is OPTIONAL - the system falls back to offline/sandbox
# implementations when a credential is not supplied.

# --- OpenAI (primary LLM + embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Second, open-source model for the comparative evaluation ---
# Install Ollama (ollama.com), then: ollama pull llama3.1:8b
# The name must match a pulled tag exactly.
OPEN_SOURCE_MODEL_NAME=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Which model answers passengers: auto | openai | ollama | offline.
#   auto    OpenAI when OPENAI_API_KEY is set, otherwise the offline composer
# Choose by running:  cd backend && python tools/compare_models.py
# Whatever is chosen, a live answer that states a figure missing from the
# policy text, or a model that is down or slower than LLM_TIMEOUT_SECONDS, is
# replaced by the offline composer's answer, and the trace says why.
CHAT_MODEL_PROVIDER=auto
LLM_TIMEOUT_SECONDS=45

# --- Conversation memory ---
# Minutes a passenger's last question and flight are remembered, so a
# follow-up such as "what about Business class?" keeps its context.
CONVERSATION_MEMORY_MINUTES=30

# --- Human handover ---
# Turn on only when staff are watching the "Passengers Waiting for a Person"
# queue in the dashboard. While off, the assistant never promises a person and
# gives HANDOVER_FALLBACK_CONTACT instead.
HANDOVER_ENABLED=false
# Optional: POST each new case (reference, reason, transcript) as JSON to the
# airline's contact-centre system. The transcript can contain personal data, so
# this must be an HTTPS endpoint Kenya Airways controls.
HANDOVER_WEBHOOK_URL=
HANDOVER_WEBHOOK_TOKEN=
# Shown to passengers when no one is available. Use the contact route Kenya
# Airways wants passengers to use.
HANDOVER_FALLBACK_CONTACT=the Kenya Airways customer service contacts listed on kenya-airways.com

# --- Data protection (app/privacy.py, docs/DPIA_draft.md) ---
# Passengers can always delete their own conversation, staff can erase a
# passenger's data on request, and staff screens always mask phone numbers.
# Automatic deletion by age is OFF until the DPIA sets the periods: switching
# it on deletes everything older than them, development history included.
PRIVACY_RETENTION_ENABLED=false
CONVERSATION_RETENTION_DAYS=30
PAYMENT_CONTACT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
PRIVACY_PURGE_INTERVAL_MINUTES=60
# Shown in the passenger privacy notice at /privacy.
PRIVACY_CONTACT=the Kenya Airways Data Protection Officer (contact details on kenya-airways.com)

# --- Kenya Airways systems (docs/kq_integration_spec.md) ---
# Booking lookup by reference and surname. Empty: two labelled demo bookings
# (KQDEMO / Wanjiru, KQBIZ1 / Otieno).
KQ_BOOKING_API_URL=
KQ_BOOKING_API_TOKEN=
BOOKING_LOOKUP_MAX_FAILURES=5
# Kenya Airways' own flight-status feed. When set it is asked first and
# AviationStack (below) becomes the backup.
KQ_FLIGHT_API_URL=
KQ_FLIGHT_API_TOKEN=
KQ_API_TIMEOUT_SECONDS=8

# --- AviationStack flight telemetry ---
AVIATIONSTACK_API_KEY=

# --- Safaricom Daraja (M-Pesa STK Push) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_SANDBOX=true
# Kenya Airways' collection account: a paybill or a till.
#   paybill: DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline, DARAJA_PARTY_B=<paybill>
#   till:    DARAJA_TRANSACTION_TYPE=CustomerBuyGoodsOnline, DARAJA_SHORTCODE=<store number>,
#            DARAJA_PARTY_B=<till number>
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Where Safaricom posts each payment's result. It must be a public https URL
# ending in /api/payments/daraja/callback/<DARAJA_CALLBACK_TOKEN>. Safaricom does
# not sign callbacks, so the token is what keeps strangers from posting fake
# results; without it every callback is refused. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Payments whose callback never arrives are still resolved through Safaricom's
# status query, so a placeholder URL only delays the result.
DARAJA_CALLBACK_URL=https://example.com/api/payments/daraja/callback/CHANGE-ME
DARAJA_CALLBACK_TOKEN=
# Confirm every success callback with Safaricom's status query before marking a
# payment paid. Leave on in production.
DARAJA_VERIFY_CALLBACKS=true

# --- Payment lifecycle ---
# Minutes a quoted fee can be accepted, and minutes a payment may stay pending
# before it is reconciled with the provider and otherwise marked expired.
PAYMENT_QUOTE_TTL_MINUTES=15
PAYMENT_PENDING_TTL_MINUTES=10

# --- PayPal Orders API (card rail) ---
# M-Pesa only reaches Safaricom subscribers and only settles in shillings. The
# card rail serves everyone else and charges the fee in the currency Kenya
# Airways publishes it in, so USD_TO_KES_RATE never applies on this route.
# Without these the assistant returns a clearly labelled simulated checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_RETURN_URL=http://localhost:8000/payment/return
PAYPAL_CANCEL_URL=http://localhost:8000/payment/cancel

# Local semantic embeddings. Set LOCAL_EMBEDDING_ENABLED=false to force the
# hashed fallback - useful for reproducing the pre-Phase-3b baseline, but it
# makes retrieval purely lexical.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_ENABLED=true

# Maximal Marginal Relevance trade-off for retrieval: 1.0 is plain top-k,
# lower values trade relevance for diversity across documents.
RETRIEVAL_MMR_LAMBDA=0.8

# Indicative USD -> KES rate used only to settle dollar-published fees over
# M-Pesa, which is shilling-denominated. This is a prototype setting, not a
# live FX feed; the assistant discloses the rate whenever it converts.
USD_TO_KES_RATE=129.0

# --- MongoDB Atlas Vector Search ---
MONGODB_URI=
MONGODB_DB_NAME=kq_propel

# --- Staff authentication for the administrative dashboard ---
# The dashboard exposes the transaction ledger, which contains passenger phone
# numbers, so it is never anonymous. There is deliberately no default password
# in the source code.
#
# Generate a hash:   cd backend && python -m app.auth "your-password"
# then paste the printed line below. Never commit a plaintext password.
#
# If neither ADMIN_PASSWORD_HASH nor ADMIN_PASSWORD is set, a one-time
# password is generated and printed to the console at every startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plaintext alternative for local development only. Ignored when a hash is set.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=300

# Set to true when serving over HTTPS so session cookies are marked Secure.
# Leaving it false on a plain-HTTP local demo is intentional; it must be true
# in any real deployment.
SECURE_COOKIES=false

# Browsers allowed to call this API. A wildcard is not permitted with
# credentialed requests and would let any site act with an operator's cookies.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Longest passenger message accepted, in characters.
MAX_MESSAGE_CHARS=2000
