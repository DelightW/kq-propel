# KQ-Propel environment configuration
# Copy this file to .env and fill in the values you have.
# Every variable is OPTIONAL - the system falls back to offline/sandbox
# implementations when a credential is not supplied.

# --- OpenAI (primary LLM + embeddings) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Second, open-source model for the comparative evaluation ---
OPEN_SOURCE_MODEL_NAME=llama3-8b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# --- AviationStack flight telemetry ---
AVIATIONSTACK_API_KEY=

# --- Safaricom Daraja (M-Pesa STK Push) ---
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_SANDBOX=true
# Safaricom requires an https callback for the payment result. The sandbox
# accepts a placeholder and still delivers the prompt to the handset, but no
# result callback can reach example.com - so an unconfirmed prompt is expected
# on a placeholder, not a failure. Use an ngrok/tunnel URL to receive results.
DARAJA_CALLBACK_URL=https://example.com/daraja/callback

# --- PayPal Orders API (card rail) ---
# M-Pesa only reaches Safaricom subscribers and only settles in shillings. The
# card rail serves everyone else and charges the fee in the currency Kenya
# Airways publishes it in, so USD_TO_KES_RATE never applies on this route.
# Without these the assistant returns a clearly labelled simulated checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_RETURN_URL=http://localhost:8000/payment/return
PAYPAL_CANCEL_URL=http://localhost:8000/payment/cancel

# Local semantic embeddings. Set LOCAL_EMBEDDING_ENABLED=false to force the
# hashed fallback - useful for reproducing the pre-Phase-3b baseline, but it
# makes retrieval purely lexical.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_ENABLED=true

# Maximal Marginal Relevance trade-off for retrieval: 1.0 is plain top-k,
# lower values trade relevance for diversity across documents.
RETRIEVAL_MMR_LAMBDA=0.8

# Indicative USD -> KES rate used only to settle dollar-published fees over
# M-Pesa, which is shilling-denominated. This is a prototype setting, not a
# live FX feed; the assistant discloses the rate whenever it converts.
USD_TO_KES_RATE=129.0

# --- MongoDB Atlas Vector Search ---
MONGODB_URI=
MONGODB_DB_NAME=kq_propel
